# Copy to .env (git ignores it) to change the demo without editing the compose
# file. Nothing in here is a secret.

# The server image. The default is the release tag in docker-compose.yml; that
# tag exists only after the release is published. For a snapshot build or a
# local image, name it here (tag or digest).
#MYOWNPKI_IMAGE=ghcr.io/der-felix/myownpki:0.3.11
