# LF everywhere (scripts must run on Linux/FreeBSD even when edited on Windows)
* text=auto eol=lf

*.go     text eol=lf
*.templ  text eol=lf
*.sql    text eol=lf
*.sh     text eol=lf
*.bash   text eol=lf
*.conf   text eol=lf
*.cnf    text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.md     text eol=lf
*.css    text eol=lf
*.ts     text eol=lf
LICENSE  text eol=lf

# Windows-only files
*.ps1    text eol=crlf
*.bat    text eol=crlf

# Binary
*.png    binary
*.ico    binary
*.woff2  binary
*.der    binary
*.p12    binary
*.pfx    binary
