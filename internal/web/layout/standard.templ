package layout

import "github.com/Der-Felix/MyOwnPKI/internal/web/components"

// Page carries what every shell needs. Pages don't know which shell renders
// them (ADR-13); phase 0 only has shell B.
type Page struct {
	Title  string
	Active string // key of the active navigation item
	Dev    bool   // show the DEV MODE banner
}

type navItem struct {
	key, label, href string
}

// nav lists the main areas. Items without href are not built yet (phase 1+).
var nav = []navItem{
	{key: "dashboard", label: "Dashboard"},
	{key: "certificates", label: "Certificates"},
	{key: "cas", label: "CAs"},
	{key: "presets", label: "Presets"},
	{key: "audit", label: "Audit log"},
	{key: "design", label: "Design", href: "/design"},
}

// Standard is shell B: top navigation, page title, optional info column.
templ Standard(p Page) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="color-scheme" content="light dark"/>
			<title>{ p.Title } · MyOwnPKI</title>
			<link rel="stylesheet" href="/static/styles/tokens.css"/>
			<link rel="stylesheet" href="/static/styles/base.css"/>
			<link rel="stylesheet" href="/static/styles/components.css"/>
			<link rel="stylesheet" href="/static/styles/layouts.css"/>
		</head>
		<body class="shell-b">
			<a class="skip-link" href="#main">Skip to content</a>
			if p.Dev {
				@components.DevBanner()
			}
			<header class="topbar">
				<span class="brand-name">MyOwnPKI</span>
				<nav class="topnav" aria-label="Main">
					for _, item := range nav {
						if item.href == "" {
							<span class="topnav-item is-disabled" aria-disabled="true" title="Not built yet">{ item.label }</span>
						} else if item.key == p.Active {
							<a class="topnav-item is-active" href={ templ.SafeURL(item.href) } aria-current="page">{ item.label }</a>
						} else {
							<a class="topnav-item" href={ templ.SafeURL(item.href) }>{ item.label }</a>
						}
					}
				</nav>
			</header>
			<main id="main" class="page">
				{ children... }
			</main>
		</body>
	</html>
}
