package certificates

import (
	"strconv"

	"github.com/Der-Felix/MyOwnPKI/internal/web/components"
	"github.com/Der-Felix/MyOwnPKI/internal/web/layout"
	"github.com/Der-Felix/MyOwnPKI/internal/web/view"
)

// ListData is the content of the certificate list.
type ListData struct {
	Messages []view.Message
	Query    string
	Statuses []view.Option
	CAs      []view.Option
	Presets  []view.Option
	Rows     []view.CertRow
	Total    int

	// Real UI (step 14): no bulk commands yet, paging by cursor.
	Real      bool
	HideAgents bool
	CanIssue  bool
	NextHref  string // next page; "" = last page
	FirstHref string // first page; "" = this is the first
}

// List renders the certificate list: filters, command bar, selectable table.
templ List(p view.Page, d ListData) {
	@layout.App(p) {
		@components.Messages(d.Messages)
		<form class="filters" action="/certificates" method="get" role="search">
			<input type="hidden" name="agent_filter" value="1"/>
			<label class="filter">
				Name or serial
				<input type="search" name="q" value={ d.Query }/>
			</label>
			<label class="filter">
				Status
				@selectBox("status", d.Statuses)
			</label>
			<label class="filter">
				Issuing CA
				@selectBox("ca", d.CAs)
			</label>
			<label class="filter">
				Preset
				@selectBox("preset", d.Presets)
			</label>
			<button type="submit" class="btn">Apply</button>
			<label class="choice">
				<input type="checkbox" name="hide_agents" value="yes" checked?={ d.HideAgents }/>
				Hide agent certificates
			</label>
			<a class="btn" href="/certificates">Reset</a>
		</form>
		if d.Real {
			if d.CanIssue {
				@components.CommandBar("Certificate commands") {
					@components.CommandGroup("Create") {
						<a class="cmd cmd-primary" href="/certificates/new">New certificate</a>
					}
				}
			}
		} else {
			<form id="selection" action="/certificates/actions" method="post">
				@components.CommandBar("Certificate commands") {
					@components.CommandGroup("Create") {
						<a class="cmd cmd-primary" href="/certificates/new">New certificate</a>
						<button type="submit" class="cmd" name="action" value="import">Import</button>
					}
					@components.CommandGroup("Edit") {
						<button type="submit" class="cmd" name="action" value="export">Export</button>
						<button type="submit" class="cmd" name="action" value="renew">Renew</button>
					}
					@components.CommandGroup("Dangerous") {
						<button type="submit" class="cmd cmd-danger" name="action" value="revoke">Revoke</button>
					}
					<span class="cmdbar-end">Select rows, then choose a command.</span>
				}
			</form>
		}
		if len(d.Rows) == 0 {
			<p class="empty">No certificates match the filter.</p>
		} else {
			@components.CertificateTable(d.Rows, !d.Real, "selection")
		}
		<div class="table-foot">
			if d.HideAgents {
				{ strconv.Itoa(len(d.Rows)) } certificates on this page
			} else {
				{ strconv.Itoa(len(d.Rows)) } of { strconv.Itoa(d.Total) } certificates
			}
			if d.FirstHref != "" {
				{ " · " }
				<a href={ templ.SafeURL(d.FirstHref) }>First page</a>
			}
			if d.NextHref != "" {
				{ " · " }
				<a href={ templ.SafeURL(d.NextHref) }>Next page</a>
			}
		</div>
	}
}

templ selectBox(name string, options []view.Option) {
	<select name={ name }>
		for _, o := range options {
			<option value={ o.Value } selected?={ o.Selected }>{ o.Label }</option>
		}
	</select>
}
