package design

import (
	"github.com/Der-Felix/MyOwnPKI/internal/web/components"
	"github.com/Der-Felix/MyOwnPKI/internal/web/layout"
	"github.com/Der-Felix/MyOwnPKI/internal/web/view"
)

// Page renders the component gallery inside the application shell.
templ Page(p view.Page) {
	@layout.App(p) {
		@colorsSection()
		@typeSection()
		@statusSection()
		@commandSection()
		@tableSection()
		@formSection()
		@detailSection()
		@previewSection()
	}
}

templ swatchGrid(list []swatch) {
	<div class="swatches">
		for _, s := range list {
			<div class="swatch">
				<span class={ "swatch-color", s.Class }></span>
				<span><span class="mono">{ s.Token }</span><br/><span class="muted">{ s.Note }</span></span>
			</div>
		}
	</div>
}

templ colorsSection() {
	<section class="section" id="colors" aria-labelledby="h-colors">
		<div class="section-head"><h2 id="h-colors">Colors</h2></div>
		<p class="muted">Neutral and brand tokens can be changed by themes (instance, tenant, user).</p>
		@swatchGrid(neutralSwatches)
		<p></p>
		<p class="muted">Status tokens are fixed – no theme can change them. Status is always written out as text.</p>
		@swatchGrid(statusSwatches)
	</section>
}

templ typeSection() {
	<section class="section" id="type" aria-labelledby="h-type">
		<div class="section-head"><h2 id="h-type">Typography</h2></div>
		<p>Type ramp (Fluent 2 as yardstick): caption 12/16, body 14/20 (also tables), subtitle 16/24, title 20/28, figures 28/36. All spacing is a multiple of 4 px.</p>
		<p class="muted">Muted text for labels and hints.</p>
		<p>Serial <span class="mono">4F3A9C21E07B5D8816A2F0C3B9D47E15</span> – serials, fingerprints and OIDs are monospace.</p>
		<p>Dates are absolute and in UTC: 2027-01-04<span class="rel">in 83 days</span></p>
		<p><a href="#type">A link</a> in running text.</p>
	</section>
}

templ statusSection() {
	<section class="section" id="status" aria-labelledby="h-status">
		<div class="section-head"><h2 id="h-status">Status and messages</h2></div>
		<p>
			@components.Status(view.StatusOK, "Valid")
			&nbsp;&nbsp;
			@components.Status(view.StatusWarn, "Expires soon")
			&nbsp;&nbsp;
			@components.Status(view.StatusCrit, "Revoked")
			&nbsp;&nbsp;
			@components.Status(view.StatusInfo, "Pending approval")
			&nbsp;&nbsp;
			@components.Status(view.StatusNeutral, "External")
		</p>
		@components.MessageBar(view.Message{Kind: view.MessageInfo, Text: "The server is sealed. Unseal it to enable signing."})
		@components.MessageBar(view.Message{Kind: view.MessageWarning, Text: "The CRL of homelab-users expires in 2 days."})
		@components.MessageBar(view.Message{Kind: view.MessageError, Text: "nas.example.org is outside the name constraints of homelab-issuing."})
		@components.MessageBar(view.Message{Kind: view.MessageSuccess, Text: "Certificate grafana.homelab.lan issued."})
	</section>
}

templ commandSection() {
	<section class="section" id="commands" aria-labelledby="h-commands">
		<div class="section-head"><h2 id="h-commands">Buttons and command bar</h2></div>
		@components.CommandBar("Example commands") {
			@components.CommandGroup("Create") {
				<button type="button" class="cmd cmd-primary">New certificate</button>
				<button type="button" class="cmd">Import</button>
			}
			@components.CommandGroup("Edit") {
				<button type="button" class="cmd">Export</button>
				<button type="button" class="cmd" disabled>Renew</button>
			}
			@components.CommandGroup("Dangerous") {
				<button type="button" class="cmd cmd-danger">Revoke</button>
			}
			<span class="cmdbar-end">2 selected</span>
		}
		<p class="muted">Groups are always ordered: create, edit or transfer, dangerous (last).</p>
		<p>
			<button type="button" class="btn btn-primary">Issue certificate</button>
			<button type="button" class="btn">Cancel</button>
			<button type="button" class="btn btn-danger">Revoke</button>
			<button type="button" class="btn">Small</button>
			<button type="button" class="btn" disabled>Disabled</button>
		</p>
	</section>
}

templ tableSection() {
	<section class="section" id="tables" aria-labelledby="h-tables">
		<div class="section-head"><h2 id="h-tables">Overview figures and tables</h2></div>
		@components.NumberRow(sampleNumbers)
		<form class="filters" action="#tables" method="get">
			<label class="filter">
				Name or serial
				<input type="search" name="q"/>
			</label>
			<label class="filter">
				Status
				<select name="status"><option>All</option><option>Valid</option></select>
			</label>
			<button type="button" class="btn">Apply</button>
		</form>
		<form id="gallery-selection" action="#tables" method="get"></form>
		@components.CertificateTable(sampleRows, true, "gallery-selection")
		<div class="table-foot">4 of 1,284 certificates</div>
	</section>
}

templ formSection() {
	<section class="section" id="forms" aria-labelledby="h-forms">
		<div class="section-head"><h2 id="h-forms">Forms and wizard steps</h2></div>
		@components.Steps(sampleSteps)
		<form class="form" action="#forms" method="get">
			@components.FormRow("g-cn", "Common name", "Display name only – clients match host names against the SANs.", "", true) {
				<input id="g-cn" type="text" name="cn" value="nas.homelab.lan"/>
			}
			@components.FormRow("g-dns", "DNS names", "", "nas.example.org is outside the name constraints of homelab-issuing (.homelab.lan).", false) {
				<textarea id="g-dns" name="dns" rows="2">nas.example.org</textarea>
			}
			@components.ChoiceRow("g-key", "Key") {
				<label class="choice"><input type="radio" name="key" checked/> Upload a CSR (recommended)</label>
				<label class="choice"><input type="radio" name="key"/> Generate the key on the server</label>
			}
			<div class="form-actions">
				<button type="button" class="btn btn-primary">Next</button>
				<button type="button" class="btn">Cancel</button>
			</div>
		</form>
	</section>
}

templ detailSection() {
	<section class="section" id="tabs" aria-labelledby="h-details">
		<div class="section-head"><h2 id="h-details">Tabs and details</h2></div>
		@components.Tabs(sampleTabs)
		<div class="columns">
			@components.KVList(sampleKV)
			<pre class="pem">{ samplePEM }</pre>
		</div>
		<p class="empty">Empty state: no certificates match the filter.</p>
	</section>
}

templ previewSection() {
	<section class="section" id="preview" aria-labelledby="h-preview">
		<div class="section-head"><h2 id="h-preview">Dark and compact</h2></div>
		<p class="muted">Same classes, other tokens: data-theme="dark" and data-density="compact" on any element.</p>
		<div class="preview" data-theme="dark" data-density="compact">
			@components.NumberRow(sampleNumbers)
			@components.CommandBar("Example commands in dark mode") {
				@components.CommandGroup("Create") {
					<button type="button" class="cmd cmd-primary">New certificate</button>
				}
				@components.CommandGroup("Edit") {
					<button type="button" class="cmd">Export</button>
				}
				@components.CommandGroup("Dangerous") {
					<button type="button" class="cmd cmd-danger">Revoke</button>
				}
			}
			@components.MessageBar(view.Message{Kind: view.MessageWarning, Text: "The CRL of homelab-users expires in 2 days."})
			@components.CertificateTable(sampleRows, false, "")
		</div>
	</section>
}
