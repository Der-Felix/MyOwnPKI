// Package trust renders the public trust portal (v0.2.2, extended in v0.3.9):
// the root and intermediate CA certificates with their fingerprints and
// downloads, and the install steps for one platform – chosen by the
// visitor or guessed from the browser. Served by the public listener at /
// without a sign-in. Only public data; no JavaScript.
package trust

import (
	"github.com/Der-Felix/MyOwnPKI/internal/trustkit"
	"github.com/Der-Felix/MyOwnPKI/internal/web/components"
	"github.com/Der-Felix/MyOwnPKI/internal/web/layout"
	"github.com/Der-Felix/MyOwnPKI/internal/web/view"
)

// CA is one certificate of a CA (one generation).
type CA struct {
	Name       string // the CA's name, part of every URL
	Kind       string // "Root CA" or "Intermediate CA"
	Root       bool
	Generation int64
	Current    bool
	CommonName string
	Valid      string // "2026-10-22 – 2046-10-17"
	// Fingerprint is authoritative SHA-256; SHA1 is only for the Windows dialog.
	Fingerprint, SHA1 string
	DER, PEM          string // download paths
	// FileDER and FilePEM are the names the browser saves them as; FileCER is
	// the DER copy with the extension Windows opens with its certificate dialog.
	FileDER, FilePEM, FileCER string
	// WinMachine, WinUser and Profile are the Windows helpers and the Apple
	// configuration profile (roots only); FileProfile is the name it is saved as.
	WinMachine, WinUser, Profile, FileProfile string
}

// Choice is one entry of the platform list.
type Choice struct {
	Label    string
	Href     string // /?os=… (from a fixed list, never from the request)
	Selected bool   // its steps are shown below
}

// RootGuide is the steps and commands for one root on one platform.
type RootGuide struct {
	CA     CA
	Blocks []trustkit.Block
}

// Section is the guide of one platform: one RootGuide per shown root.
type Section struct {
	ID    string // trustkit platform name, used in anchors
	Title string
	Roots []RootGuide
}

// Data is the page.
type Data struct {
	Roots, Intermediates []CA
	// Detected is the platform name guessed from the browser ("" when nothing
	// was found or the visitor chose with ?os=); the text comes from a fixed table.
	Detected string
	Choices  []Choice
	// Sections are the guides to show; none means the page offers only the list.
	Sections []Section
	// FirefoxHint is set when the browser is Firefox and its steps are not shown.
	FirefoxHint bool
}

templ Page(p view.Page, d Data) {
	@layout.Plain(p) {
		<section class="section" aria-labelledby="h-warning">
			<div class="section-head"><h2 id="h-warning">Before you install anything</h2></div>
			@components.Messages([]view.Message{{Kind: view.MessageWarning, Text: "This page comes over plain HTTP. Nothing on it proves itself, not even the fingerprints: anyone in the network path could change this page, the downloads and the commands together. Before you install a root, compare its SHA-256 fingerprint with a value you got another way."}})
			<p>Where to get that value:</p>
			<ul>
				<li>in the admin UI: <em>Authorities</em>, open the root (it shows the SHA-256 fingerprint);</li>
				<li>on the PKI server: <code>myownpki ca show NAME</code> prints the SHA-256 of every generation;</li>
				<li>from your administrator, a printout or a message you trust.</li>
			</ul>
			<p>
				To see the value of a file you downloaded: <code>openssl x509 -inform DER -in FILE -noout -fingerprint -sha256</code>.
				That helps only when you compare it with a value from the list above.
			</p>
		</section>
		<section class="section" aria-labelledby="h-roots">
			<div class="section-head"><h2 id="h-roots">Root certificates</h2></div>
			<p>
				Install a <strong>root CA</strong> once on every device and browser that should trust the
				certificates of this PKI.
			</p>
			if len(d.Roots) == 0 {
				<p class="muted">There is no root certificate authority to show yet.</p>
			} else {
				@caTable(d.Roots)
				for _, c := range d.Roots {
					<div class="section-head">
						<h3>SHA-256 of { c.Name }</h3>
						if !c.Current {
							<span class="muted">older generation { itoa(c.Generation) }, still valid</span>
						}
					</div>
					<pre class="fingerprint">{ c.Fingerprint }</pre>
				}
			}
		</section>
		<section class="section" aria-labelledby="h-system">
			<div class="section-head"><h2 id="h-system">Your system</h2></div>
			if d.Detected != "" {
				<p>Your browser says: <strong>{ d.Detected }</strong>. That is a guess; choose another system if it is wrong.</p>
			} else if len(d.Sections) == 0 {
				<p>This page could not tell your system. Choose it:</p>
			} else {
				<p>Choose a system:</p>
			}
			<ul>
				for _, c := range d.Choices {
					<li>
						<a href={ templ.SafeURL(c.Href) }>{ c.Label }</a>
						if c.Selected {
							<span class="muted">– shown below</span>
						}
					</li>
				}
			</ul>
			if d.FirefoxHint {
				<p class="muted">Your browser is Firefox. It keeps its own list of certificate authorities on most systems: see <a href="/?os=firefox">the Firefox steps</a>.</p>
			}
		</section>
		for _, s := range d.Sections {
			@guide(s)
		}
		if len(d.Intermediates) > 0 {
			<section class="section" aria-labelledby="h-intermediates">
				<div class="section-head"><h2 id="h-intermediates">Intermediate certificates</h2></div>
				<p>Servers send these along with their own certificate: install nothing. The files are here for servers and tools that need them.</p>
				@caTable(d.Intermediates)
			</section>
		}
	}
}

// caTable lists certificates: what they are and the downloads.
templ caTable(list []CA) {
	<div class="table-wrap">
		<table class="table">
			<thead>
				<tr>
					<th>Name</th>
					<th>Common name</th>
					<th>Valid</th>
					<th>Download</th>
				</tr>
			</thead>
			<tbody>
				for _, c := range list {
					<tr>
						<td>
							{ c.Name }
							if !c.Current {
								<span class="muted">(older generation { itoa(c.Generation) }, still valid)</span>
							}
						</td>
						<td>{ c.CommonName }</td>
						<td>{ c.Valid }</td>
						<td>
							<div><a href={ templ.SafeURL(c.DER) } download={ c.FileDER }>{ c.FileDER } (DER)</a></div>
							<div><a href={ templ.SafeURL(c.PEM) } download={ c.FilePEM }>{ c.FilePEM } (PEM)</a></div>
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
}

// guide is the steps of one platform for every shown root.
templ guide(s Section) {
	<section class="section" aria-labelledby={ "h-" + s.ID }>
		<div class="section-head"><h2 id={ "h-" + s.ID }>{ s.Title }</h2></div>
		if s.ID == "windows" {
			<p>
				The <strong>Windows helper</strong> shows the root's SHA-256 and SHA-1. Only SHA-256 authorizes trust;
				SHA-1 is display-only for comparison with the Windows certificate dialog. Compare SHA-256 with the
				exact value from the authenticated admin UI or your administrator, then type YES, or pass that exact
				64-hex value as <code>-ExpectedSha256</code> to import noninteractively. <em>This computer</em> asks for
				administrator rights and works for all users; <em>my user only</em> needs none (Windows asks once to
				confirm). <code>/check</code> only displays and checks; <code>/quiet</code> never bypasses authorization.
			</p>
		}
		for _, r := range s.Roots {
			<div class="section">
				<div class="section-head">
					<h3>{ r.CA.Name } – { r.CA.CommonName }</h3>
					if !r.CA.Current {
						<span class="muted">older generation { itoa(r.CA.Generation) }, still valid</span>
					}
				</div>
				@downloads(s.ID, r.CA)
				if s.ID == "windows" {
					<p>SHA-1 fingerprint (Windows certificate dialog comparison only):</p>
					<pre class="fingerprint">{ r.CA.SHA1 }</pre>
				}
				for _, b := range r.Blocks {
					<div class="section-head"><h4>{ b.Title }</h4></div>
					if len(b.Steps) > 0 {
						<ol>
							for _, step := range b.Steps {
								<li>{ step }</li>
							}
						</ol>
					}
					if len(b.Lines) > 0 {
						<pre class="pem">{ join(b.Lines) }</pre>
					}
					if b.Note != "" {
						<p class="muted">{ b.Note }</p>
					}
				}
			</div>
		}
	</section>
}

// downloads are the files a platform needs, as buttons.
templ downloads(id string, c CA) {
	<div class="btn-row">
		switch id {
			case "windows":
				<a class="btn" href={ templ.SafeURL(c.DER) } download={ c.FileCER }>Download { c.FileCER }</a>
				<a class="btn" href={ templ.SafeURL(c.WinMachine) }>Windows helper: this computer</a>
				<a class="btn" href={ templ.SafeURL(c.WinUser) }>Windows helper: my user only</a>
			case "macos", "ios":
				<a class="btn" href={ templ.SafeURL(c.Profile) }>Download profile { c.FileProfile }</a>
			case "debian", "fedora", "java":
				<a class="btn" href={ templ.SafeURL(c.DER) } download={ c.FileDER }>Download { c.FileDER } (DER)</a>
				<a class="btn" href={ templ.SafeURL(c.PEM) } download={ c.FilePEM }>Download { c.FilePEM } (PEM)</a>
			default:
				<a class="btn" href={ templ.SafeURL(c.DER) } download={ c.FileDER }>Download { c.FileDER } (DER)</a>
		}
	</div>
}
