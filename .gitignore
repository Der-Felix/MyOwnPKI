# Build output
/bin/
/dist/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out

# Go
/vendor/
go.work
go.work.sum
coverage.*
*.coverprofile

# Runtime data (never commit databases or real keys)
/data/
*.db
*.db-wal
*.db-shm
*.sqlite
/var/

# Legacy script runtime output
/legacy/pki/
/legacy/dist/

# Secrets and local config
.env
.env.*
!.env.example
*.local.yaml
*.local.toml

# Dev tooling (Node is only allowed for optional E2E tests, never in the product)
node_modules/
/test-results/
/playwright-report/

# Editors / OS
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
.DS_Store
Thumbs.db

# Claude Code: personal, machine-specific files (never commit)
.claude/settings.local.json
CLAUDE.local.md

# Scratch output of tools (the UI inventory of internal/tools/screenshots): never committed
/.tmp/

# Test tools built by tasks (lego, pebble) – never committed
/.tools/

# graphify knowledge graph (generated, ~9 MB; rebuild with `graphify update .`)
/graphify-out/

# Documentation site (site/, built by .github/workflows/pages.yml): generated by
# scripts/ci/site-prepare.sh from docs/OPERATIONS.md, CHANGELOG.md and
# deploy/config.example.yaml, and the Jekyll output
/site/reference/
/site/_data/release.yml
/site/_site/
/site/.jekyll-cache/
/site/.jekyll-metadata
